{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://path-finder/venue.schema.json",
  "title": "Path Finder – areál",
  "additionalProperties": false,
  "description": "Areál – koreňový objekt dátového modelu.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "buildings",
    "levels",
    "spaces",
    "openings",
    "vertical",
    "pois",
    "rules",
    "zones",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "id": {
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "minLength": 1,
      "description": "Identifikátor, zhodný s `id` prvku v SVG.",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "defaults": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "floorHeight": {
          "exclusiveMinimum": 0,
          "description": "Výška podlažia v m; predvolene 3.5.",
          "type": "number"
        },
        "wallTolerance": {
          "minimum": 0,
          "description": "Max. vzdialenosť prechodu od hranice priestoru v m (hrúbka steny); predvolene 0.5.",
          "type": "number"
        },
        "speed": {
          "exclusiveMinimum": 0,
          "description": "Rýchlosť chôdze v m/s; predvolene 1.3.",
          "type": "number"
        }
      }
    },
    "geoReference": {
      "additionalProperties": false,
      "description": "Voliteľné ukotvenie lokálneho systému v GPS jedným referenčným bodom (R5).",
      "type": "object",
      "required": [
        "point",
        "lat",
        "lon"
      ],
      "properties": {
        "point": {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "lat": {
          "minimum": -90,
          "maximum": 90,
          "type": "number"
        },
        "lon": {
          "minimum": -180,
          "maximum": 180,
          "type": "number"
        },
        "bearing": {
          "description": "Azimut osi −y lokálneho systému v stupňoch od severu.",
          "type": "number"
        }
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "levels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "description": "Podlažie budovy, alebo vonkajšia vrstva, ak `building` chýba.",
        "type": "object",
        "required": [
          "id",
          "ordinal"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "building": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "ordinal": {
            "description": "Poradie podlažia; 0 = prízemie, záporné = suterén.",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "elevation": {
            "description": "Výška podlahy v metroch; predvolene ordinal · floorHeight.",
            "type": "number"
          },
          "svg": {
            "description": "Súbor s geometriou podlažia.",
            "type": "string"
          },
          "transform": {
            "additionalProperties": false,
            "description": "local = R(rotation) · (scale · svg) + offset (R5).",
            "type": "object",
            "required": [
              "scale",
              "rotation",
              "offset"
            ],
            "properties": {
              "scale": {
                "exclusiveMinimum": 0,
                "description": "Metrov na jednotku SVG.",
                "type": "number"
              },
              "rotation": {
                "description": "Stupne; os y smeruje nadol, kladný uhol je v smere hodinových ručičiek.",
                "type": "number"
              },
              "offset": {
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "additionalItems": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    "spaces": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "description": "Priestor – polygón v SVG podlažia (R1).",
        "type": "object",
        "required": [
          "id",
          "level",
          "type"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "level": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "type": {
            "anyOf": [
              {
                "const": "room",
                "type": "string"
              },
              {
                "const": "corridor",
                "type": "string"
              },
              {
                "const": "hall",
                "type": "string"
              },
              {
                "const": "lobby",
                "type": "string"
              },
              {
                "const": "stairs",
                "type": "string"
              },
              {
                "const": "elevator",
                "type": "string"
              },
              {
                "const": "warehouse",
                "type": "string"
              },
              {
                "const": "office",
                "type": "string"
              },
              {
                "const": "restroom",
                "type": "string"
              },
              {
                "const": "walkway",
                "type": "string"
              },
              {
                "const": "road",
                "type": "string"
              },
              {
                "const": "courtyard",
                "type": "string"
              },
              {
                "const": "parking",
                "type": "string"
              },
              {
                "const": "other",
                "type": "string"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "zone": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "accessible": {
            "description": "Či je priestor bezbariérový; predvolene áno.",
            "type": "boolean"
          },
          "criteria": {
            "additionalProperties": false,
            "description": "Mäkké kritériá priestoru (R7); profil určuje ich váhu.",
            "type": "object",
            "properties": {
              "preferred": {
                "description": "Preferovaná trasa (napr. vyznačený chodník).",
                "type": "boolean"
              },
              "avoid": {
                "description": "Priestor, ktorému sa má trasa radšej vyhnúť (napr. pohyb vozíkov).",
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "description": "Prechod – úsečka (`<line>`) na spoločnej hranici dvoch priestorov (R3).",
        "type": "object",
        "required": [
          "id",
          "between"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "between": {
            "type": "array",
            "items": [
              {
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "minLength": 1,
                "description": "Identifikátor, zhodný s `id` prvku v SVG.",
                "type": "string"
              },
              {
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "minLength": 1,
                "description": "Identifikátor, zhodný s `id` prvku v SVG.",
                "type": "string"
              }
            ],
            "additionalItems": false,
            "minItems": 2,
            "maxItems": 2
          },
          "type": {
            "anyOf": [
              {
                "const": "door",
                "type": "string"
              },
              {
                "const": "gate",
                "type": "string"
              },
              {
                "const": "turnstile",
                "type": "string"
              },
              {
                "const": "virtual",
                "type": "string"
              }
            ]
          },
          "oneWay": {
            "description": "Prechod je možný iba v smere between[0] → between[1].",
            "type": "boolean"
          },
          "accessible": {
            "description": "Predvolene áno.",
            "type": "boolean"
          },
          "rules": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "minLength": 1,
              "description": "Identifikátor, zhodný s `id` prvku v SVG.",
              "type": "string"
            }
          }
        }
      }
    },
    "vertical": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "description": "Vertikálne spojenie – jeden objekt pre viacero podlaží (R3).",
        "type": "object",
        "required": [
          "id",
          "type",
          "spaces"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "type": {
            "anyOf": [
              {
                "const": "stairs",
                "type": "string"
              },
              {
                "const": "elevator",
                "type": "string"
              },
              {
                "const": "ramp",
                "type": "string"
              },
              {
                "const": "escalator",
                "type": "string"
              }
            ]
          },
          "spaces": {
            "minProperties": 2,
            "description": "Podlažie → priestor (šachta, schodisko) na tom podlaží.",
            "type": "object",
            "patternProperties": {
              "^[A-Za-z0-9_.:-]+$": {
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "minLength": 1,
                "description": "Identifikátor, zhodný s `id` prvku v SVG.",
                "type": "string"
              }
            }
          },
          "accessible": {
            "description": "Predvolene nie pre schody a eskalátor, inak áno.",
            "type": "boolean"
          },
          "rules": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "minLength": 1,
              "description": "Identifikátor, zhodný s `id` prvku v SVG.",
              "type": "string"
            }
          }
        }
      }
    },
    "pois": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "description": "Bod záujmu. Poloha je `<circle>` s rovnakým `id`, inak reprezentatívny bod priestoru.",
        "type": "object",
        "required": [
          "id",
          "space",
          "category"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "space": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "category": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "internal": {
            "description": "Interný bod, návštevník ho nevidí (N6).",
            "type": "boolean"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "description": "Pravidlo prístupu – tvrdé obmedzenie definované raz na úrovni areálu (R6).",
        "anyOf": [
          {
            "additionalProperties": false,
            "description": "Vyžaduje prístupovú kartu.",
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "minLength": 1,
                "description": "Identifikátor, zhodný s `id` prvku v SVG.",
                "type": "string"
              },
              "type": {
                "const": "card",
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          {
            "additionalProperties": false,
            "description": "Vyžaduje aspoň jednu z rolí.",
            "type": "object",
            "required": [
              "id",
              "type",
              "roles"
            ],
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "minLength": 1,
                "description": "Identifikátor, zhodný s `id` prvku v SVG.",
                "type": "string"
              },
              "type": {
                "const": "role",
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "roles": {
                "minItems": 1,
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "additionalProperties": false,
            "description": "Časové okno. Ak from > to, okno prechádza cez polnoc (nočná zmena).",
            "type": "object",
            "required": [
              "id",
              "type",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "minLength": 1,
                "description": "Identifikátor, zhodný s `id` prvku v SVG.",
                "type": "string"
              },
              "type": {
                "const": "time",
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "days": {
                "minItems": 1,
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "const": "Mo",
                      "type": "string"
                    },
                    {
                      "const": "Tu",
                      "type": "string"
                    },
                    {
                      "const": "We",
                      "type": "string"
                    },
                    {
                      "const": "Th",
                      "type": "string"
                    },
                    {
                      "const": "Fr",
                      "type": "string"
                    },
                    {
                      "const": "Sa",
                      "type": "string"
                    },
                    {
                      "const": "Su",
                      "type": "string"
                    }
                  ]
                }
              },
              "from": {
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "Čas HH:MM.",
                "type": "string"
              },
              "to": {
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
                "description": "Čas HH:MM.",
                "type": "string"
              }
            }
          },
          {
            "additionalProperties": false,
            "description": "Vyžaduje osobné ochranné pracovné prostriedky (OOPP).",
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "pattern": "^[A-Za-z0-9_.:-]+$",
                "minLength": 1,
                "description": "Identifikátor, zhodný s `id` prvku v SVG.",
                "type": "string"
              },
              "type": {
                "const": "ppe",
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "description": "Skupina priestorov; jej pravidlá platia pre prechody vedúce do zóny zvonka (R6).",
        "type": "object",
        "required": [
          "id",
          "rules"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "rules": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "minLength": 1,
              "description": "Identifikátor, zhodný s `id` prvku v SVG.",
              "type": "string"
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "description": "Profil používateľa – používateľ volí profil, nie jednotlivé váhy (R8).",
        "type": "object",
        "required": [
          "id",
          "roles",
          "weights"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "minLength": 1,
            "description": "Identifikátor, zhodný s `id` prvku v SVG.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "card": {
            "type": "boolean"
          },
          "ppe": {
            "type": "boolean"
          },
          "require": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "const": "accessible",
              "type": "string"
            }
          },
          "internal": {
            "description": "Vidí interné body záujmu (N6).",
            "type": "boolean"
          },
          "speed": {
            "exclusiveMinimum": 0,
            "description": "Rýchlosť chôdze v m/s.",
            "type": "number"
          },
          "weights": {
            "additionalProperties": false,
            "description": "Váhy mäkkých kritérií (R7).",
            "type": "object",
            "properties": {
              "distance": {
                "minimum": 0,
                "type": "number"
              },
              "time": {
                "minimum": 0,
                "type": "number"
              },
              "outdoor": {
                "minimum": 0,
                "description": "Penalizácia za úseky vonku.",
                "type": "number"
              },
              "avoid": {
                "minimum": 0,
                "description": "Penalizácia za priestory s criteria.avoid.",
                "type": "number"
              },
              "unpreferred": {
                "minimum": 0,
                "description": "Penalizácia mimo priestorov s criteria.preferred.",
                "type": "number"
              },
              "levelChanges": {
                "minimum": 0,
                "description": "Penalizácia za každú zmenu podlažia.",
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
